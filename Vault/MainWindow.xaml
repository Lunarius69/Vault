<Window x:Class="Vault.MainWindow" Icon="/Assets/vault.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault" Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Window.Resources>
        <!-- Sidebar button style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b2bec3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d3561"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active sidebar button style -->
        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#16213e">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" BorderBrush="#2d3561" BorderThickness="0,0,0,1">
                    <TextBlock Text="🎮 VAULT"
                               Foreground="#e94560"
                               FontSize="22"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </Border>

                <!-- Nav buttons -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="LIBRARY" Foreground="#636e72"
                               FontSize="10" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="28,8,0,4"/>

                    <Button x:Name="BtnGames" Content="🎮   Games"
                            Style="{StaticResource SidebarButtonActive}"
                            Click="BtnGames_Click"/>

                    <Button x:Name="BtnShows" Content="📺   TV Shows"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnShows_Click"/>

                    <Button x:Name="BtnMovies" Content="🎬   Movies"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnMovies_Click"/>

                    <Button x:Name="BtnAnime" Content="🎌   Anime"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnAnime_Click"/>

                    <TextBlock Text="GAMES" Foreground="#636e72"
                               FontSize="10" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="28,16,0,4"/>

                    <Button x:Name="BtnWishlist" Content="❤   Wishlist"
                            Style="{StaticResource SidebarButton}"
                            Click="BtnWishlist_Click"/>
                </StackPanel>

                <!-- Settings button -->
                <Button Grid.Row="2" x:Name="BtnSettings"
                        Content="⚙   Settings"
                        Style="{StaticResource SidebarButton}"
                        Margin="0,0,0,16"
                        Click="BtnSettings_Click"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Border Grid.Column="1" Background="#1a1a2e">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="#16213e"
                        BorderBrush="#2d3561" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search box -->
                        <Border Grid.Column="0" Background="#0f3460"
                                CornerRadius="8" Height="36"
                                VerticalAlignment="Center"
                                MaxWidth="400" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍"
                                           VerticalAlignment="Center"
                                           Margin="12,0,8,0" FontSize="14"/>
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#ffffff"
                                         CaretBrush="#ffffff"
                                         FontSize="13"
                                         FontFamily="Segoe UI"
                                         VerticalAlignment="Center"
                                         Padding="0,0,12,0"
                                         TextChanged="SearchBox_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock x:Name="placeholder"
                                                                       Text="Search your library..."
                                                                       Foreground="#636e72"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       IsHitTestVisible="False"
                                                                       Visibility="Collapsed"/>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="Text" Value=""/>
                                                                    <Condition Property="IsFocused" Value="False"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- View toggle -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button x:Name="BtnGridView" Content="⊞"
                                    Width="36" Height="36"
                                    Background="#e94560" Foreground="White"
                                    BorderThickness="0" FontSize="16"
                                    Cursor="Hand" ToolTip="Grid View"
                                    Click="BtnGridView_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnListView" Content="☰"
                                    Width="36" Height="36"
                                    Background="#2d3561" Foreground="#b2bec3"
                                    BorderThickness="0" FontSize="16"
                                    Cursor="Hand" ToolTip="List View"
                                    Margin="8,0,0,0"
                                    Click="BtnListView_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page content frame -->
                <Frame x:Name="MainFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       Background="#1a1a2e"/>
            </Grid>
        </Border>
    </Grid>
</Window>
