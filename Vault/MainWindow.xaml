<Window x:Class="Vault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vault" Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#1a1a2e">

    <!-- FIX: replaces the default OS title bar (system chrome — the "old
         Windows XP" look) with a custom dark title bar matching the rest of
         the app. WindowChrome keeps native resize-by-edge/corner, Aero Snap,
         and drag-to-move working "for free" — CaptionHeight marks the custom
         title bar row as the draggable/double-click-to-maximize region, the
         same way a normal title bar behaves. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             CornerRadius="0"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="6"
                             UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b2bec3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d3561"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonActive" TargetType="Button"
               BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Title bar min/maximize/close buttons -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b2bec3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2d3561"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button"
               BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e94560"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#16213e"
                BorderBrush="#2d3561" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Margin="14,0,0,0" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="🎮" FontSize="13" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="VAULT" Foreground="#b2bec3"
                               FontFamily="Segoe UI" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Column 1 (the empty * column) is the draggable caption area -->

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Content="&#xE921;"
                            Style="{StaticResource TitleBarButton}"
                            Click="BtnMinimize_Click"
                            ToolTip="Minimize"/>
                    <Button x:Name="BtnMaximizeRestore" Content="&#xE922;"
                            Style="{StaticResource TitleBarButton}"
                            Click="BtnMaximizeRestore_Click"
                            ToolTip="Maximize"/>
                    <Button x:Name="BtnClose" Content="&#xE8BB;"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="BtnClose_Click"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#16213e">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#2d3561" BorderThickness="0,0,0,1">
                        <TextBlock Text="🎮 VAULT"
                                   Foreground="#e94560" FontSize="22"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="LIBRARY" Foreground="#636e72"
                                       FontSize="10" FontWeight="Bold"
                                       FontFamily="Segoe UI" Margin="28,8,0,4"/>

                            <Button x:Name="BtnGames" Content="🎮   Games"
                                    Style="{StaticResource SidebarButtonActive}"
                                    Click="BtnGames_Click"/>
                            <Button x:Name="BtnShows" Content="📺   TV Shows"
                                    Style="{StaticResource SidebarButton}"
                                    Click="BtnShows_Click"/>
                            <Button x:Name="BtnMovies" Content="🎬   Movies"
                                    Style="{StaticResource SidebarButton}"
                                    Click="BtnMovies_Click"/>
                            <Button x:Name="BtnAnime" Content="🎌   Anime Series"
                                    Style="{StaticResource SidebarButton}"
                                    Click="BtnAnime_Click"/>
                            <Button x:Name="BtnAnimeMov" Content="🎥   Anime Movies"
                                    Style="{StaticResource SidebarButton}"
                                    Click="BtnAnimeMov_Click"/>
                            <Button x:Name="BtnAnimated" Content="🎨   Animated Series"
                                    Style="{StaticResource SidebarButton}"
                                    Click="BtnAnimated_Click"/>
                            <Button x:Name="BtnAnimatedMov" Content="🎭   Animated Movies"
                                    Style="{StaticResource SidebarButton}"
                                    Click="BtnAnimatedMov_Click"/>

                            <TextBlock Text="OTHER" Foreground="#636e72"
                                       FontSize="10" FontWeight="Bold"
                                       FontFamily="Segoe UI" Margin="28,16,0,4"/>

                            <Button x:Name="BtnStats" Content="📊   Statistics"
                                    Style="{StaticResource SidebarButton}"
                                    Click="BtnStats_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" x:Name="BtnSettings"
                            Content="⚙   Settings"
                            Style="{StaticResource SidebarButton}"
                            Margin="0,0,0,16"
                            Click="BtnSettings_Click"/>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Border Grid.Column="1" Background="#1a1a2e">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Border Grid.Row="0" Background="#16213e"
                            BorderBrush="#2d3561" BorderThickness="0,0,0,1">
                        <Grid Margin="24,0">
                            <Border Background="#0f3460"
                                    CornerRadius="8" Height="36"
                                    VerticalAlignment="Center"
                                    MaxWidth="400" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍"
                                               VerticalAlignment="Center"
                                               Margin="12,0,8,0" FontSize="14"/>
                                    <TextBox x:Name="SearchBox"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#ffffff"
                                             CaretBrush="#ffffff"
                                             FontSize="13" FontFamily="Segoe UI"
                                             VerticalAlignment="Center"
                                             Padding="0,0,12,0"
                                             TextChanged="SearchBox_TextChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Grid>
                                                                <TextBlock x:Name="placeholder"
                                                                           Text="Search your library..."
                                                                           Foreground="#636e72"
                                                                           FontFamily="Segoe UI"
                                                                           FontSize="13"
                                                                           VerticalAlignment="Center"
                                                                           IsHitTestVisible="False"
                                                                           Visibility="Collapsed"/>
                                                                <ScrollViewer x:Name="PART_ContentHost"
                                                                              VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="Text" Value=""/>
                                                                        <Condition Property="IsFocused" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="placeholder"
                                                                            Property="Visibility" Value="Visible"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Page content -->
                    <ContentControl x:Name="MainContent" Grid.Row="1"
                                    Background="#1a1a2e"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
