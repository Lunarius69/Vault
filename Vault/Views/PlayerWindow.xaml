<Window x:Class="Vault.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Vault Player"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">

    <Grid x:Name="RootGrid" Background="Black">

        <!-- VLC Video Surface -->
        <vlc:VideoView x:Name="VideoView"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"/>

        <!-- Transparent click overlay for play/pause -->
        <Grid Background="Transparent"
              MouseLeftButtonDown="ClickOverlay_MouseLeftButtonDown"/>

        <!-- Top gradient bar -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Height="80">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#BB000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock x:Name="TxtEpisodeTitle"
                       Foreground="White" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="20,0,60,0"
                       TextTrimming="CharacterEllipsis"/>
            <Button Content="✕" Click="BtnClose_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,16,0" Width="40" Height="40"
                    FontSize="18" Foreground="White"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Bottom controls bar — always visible, fades on inactivity -->
        <Grid x:Name="BottomBar" VerticalAlignment="Bottom">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Margin="20,12,20,16">

                <!-- Seek bar -->
                <Grid x:Name="SeekBarGrid" Height="10" Margin="0,0,0,10"
                      Cursor="Hand"
                      MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
                      MouseMove="SeekBar_MouseMove"
                      MouseLeftButtonUp="SeekBar_MouseLeftButtonUp">
                    <!-- Background track -->
                    <Rectangle Fill="#55FFFFFF" RadiusX="4" RadiusY="4"/>
                    <!-- Intro highlight (orange) -->
                    <Rectangle x:Name="IntroHighlight"
                               Fill="#CCF39C12" RadiusX="3" RadiusY="3"
                               HorizontalAlignment="Left" Width="0"
                               Visibility="Collapsed"/>
                    <!-- Outro highlight (blue) -->
                    <Rectangle x:Name="OutroHighlight"
                               Fill="#CC0984e3" RadiusX="3" RadiusY="3"
                               HorizontalAlignment="Left" Width="0"
                               Visibility="Collapsed"/>
                    <!-- Progress fill -->
                    <Rectangle x:Name="ProgressFill"
                               Fill="White" RadiusX="4" RadiusY="4"
                               HorizontalAlignment="Left" Width="0"/>
                    <!-- Thumb -->
                    <Ellipse x:Name="SeekThumb"
                             Width="14" Height="14" Fill="White"
                             HorizontalAlignment="Left" Margin="-7,0,0,0"/>
                </Grid>

                <!-- Controls row -->
                <Grid>
                    <!-- Left controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPlayPause" Content="⏸"
                                Width="44" Height="44" FontSize="22"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnPlayPause_Click"/>
                        <Button Content="⏪" ToolTip="Back 10s"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="4,0"
                                Click="BtnSkipBack_Click"/>
                        <Button Content="⏩" ToolTip="Forward 10s"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="4,0,12,0"
                                Click="BtnSkipForward_Click"/>
                        <TextBlock Text="🔊" Foreground="White" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0"
                                Maximum="100" Value="100" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="TxtTime" Text="0:00:00 / 0:00:00"
                                   Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <!-- Right controls -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="⛶" ToolTip="Fullscreen"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnFullscreen_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- SKIP INTRO button -->
        <Border x:Name="BtnSkipIntro"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,90"
                Background="#CC000000" BorderBrush="White" BorderThickness="1.5"
                CornerRadius="3" Padding="16,10" Cursor="Hand"
                Visibility="Collapsed"
                MouseLeftButtonDown="BtnSkipIntro_Click">
            <TextBlock Text="Skip Intro  ▶" Foreground="White"
                       FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <!-- NEXT EPISODE button -->
        <Border x:Name="BtnNextEpisode"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,90"
                Background="#CC000000" BorderBrush="White" BorderThickness="1.5"
                CornerRadius="3" Padding="16,10" Cursor="Hand"
                Visibility="Collapsed"
                MouseLeftButtonDown="BtnNextEpisode_Click">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="NEXT EPISODE" Foreground="#AAAAAA"
                               FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtNextEpisodeTitle" Foreground="White"
                               FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="  ▶" Foreground="White" FontSize="18"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
