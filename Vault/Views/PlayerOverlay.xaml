<UserControl x:Class="Vault.Views.PlayerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid x:Name="OverlayRoot" Background="Transparent">
        <!-- Top bar -->
        <Border x:Name="TopBar" Background="#20000000" Height="56" VerticalAlignment="Top" Opacity="0">
            <Grid>
                <TextBlock x:Name="TxtTitle" Text="Title" Foreground="White" VerticalAlignment="Center" Margin="16,0"/>
            </Grid>
        </Border>

        <!-- Bottom bar / controls -->
        <Border x:Name="BottomBar" Background="#20000000" Height="96" VerticalAlignment="Bottom" Opacity="0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Seek bar row -->
                <Grid x:Name="SeekBarGrid" Height="8" VerticalAlignment="Center">
                    <Border Background="#22000000" CornerRadius="4" Height="8"/>
                    <Border x:Name="ProgressFill" Background="#e94560" CornerRadius="4" Height="8" Width="0"/>
                    <Ellipse x:Name="SeekThumb" Width="14" Height="14" Fill="White" Margin="0,-3,0,0" HorizontalAlignment="Left"/>
                </Grid>

                <!-- Buttons row -->
                <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="BtnPrevEpisode" Content="⏮" Width="44" Height="44" Margin="0,0,0,0"/>
                    <Button x:Name="BtnSkipBack" Content="⏪" Width="44" Height="44" Margin="12,0,0,0"/>
                    <Button x:Name="BtnPlayPause" Content="▶" Width="64" Height="64" Margin="12,0,0,0"/>
                    <Button x:Name="BtnSkipForward" Content="⏩" Width="44" Height="44" Margin="12,0,0,0"/>
                    <Button x:Name="BtnNextEpisodeBtn" Content="⏭" Width="44" Height="44" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="TxtTime" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Skip intro / next overlay buttons (simple placeholders) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
            <Border x:Name="BtnSkipIntro" Background="#e94560" Padding="8" CornerRadius="6" Visibility="Collapsed">
                <TextBlock Text="Skip Intro" Foreground="White"/>
            </Border>
            <Border x:Name="BtnNextEpisode" Background="#e94560" Padding="8" CornerRadius="6" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Next" Foreground="White"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>