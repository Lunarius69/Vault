<Window x:Class="Vault.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VaultOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Background="#01000000">

        <!-- Top bar -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Height="80">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#BB000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock x:Name="TxtTitle" Foreground="White" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="20,0,60,0" TextTrimming="CharacterEllipsis"/>
            <Button Content="✕" Click="BtnClose_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,16,0" Width="40" Height="40" FontSize="18"
                    Foreground="White" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Focusable="False"/>
        </Grid>

        <!-- Bottom bar -->
        <Grid x:Name="BottomBar" VerticalAlignment="Bottom">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Margin="20,12,20,0">

                <!-- Seek bar -->
                <Grid x:Name="SeekBarGrid" Height="10" Margin="0,0,0,10"
                      Cursor="Hand"
                      MouseLeftButtonDown="SeekBar_MouseLeftButtonDown"
                      MouseMove="SeekBar_MouseMove"
                      MouseLeftButtonUp="SeekBar_MouseLeftButtonUp">
                    <Rectangle Fill="#55FFFFFF" RadiusX="4" RadiusY="4"/>
                    <Rectangle x:Name="IntroHighlight" Fill="#CCF39C12"
                               RadiusX="3" RadiusY="3" HorizontalAlignment="Left"
                               Width="0" Visibility="Collapsed"/>
                    <Rectangle x:Name="OutroHighlight" Fill="#CC0984e3"
                               RadiusX="3" RadiusY="3" HorizontalAlignment="Left"
                               Width="0" Visibility="Collapsed"/>
                    <Rectangle x:Name="ProgressFill" Fill="White"
                               RadiusX="4" RadiusY="4"
                               HorizontalAlignment="Left" Width="0"/>
                    <Ellipse x:Name="SeekThumb" Width="14" Height="14"
                             Fill="White" HorizontalAlignment="Left"
                             Margin="-7,0,0,0"/>
                </Grid>

                <!-- Controls row -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Play/Pause -->
                        <Button x:Name="BtnPlayPause" Content="⏸"
                                Width="44" Height="44" FontSize="22"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Focusable="False"
                                Click="BtnPlayPause_Click"/>

                        <!-- Skip back 10s -->
                        <Button Content="⏪" ToolTip="Back 10s"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="4,0"
                                Focusable="False" Click="BtnSkipBack_Click"/>

                        <!-- Skip forward 10s -->
                        <Button Content="⏩" ToolTip="Forward 10s"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="4,0,12,0"
                                Focusable="False" Click="BtnSkipForward_Click"/>

                        <!-- Previous episode -->
                        <Button Content="⏮" ToolTip="Previous Episode"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="4,0"
                                Focusable="False" Click="BtnPrevEpisode_Click"/>

                        <!-- Next episode -->
                        <Button Content="⏭" ToolTip="Next Episode"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="4,0,16,0"
                                Focusable="False" Click="BtnNextEpisodeBtn_Click"/>

                        <!-- Volume — mouse only, not focusable -->
                        <TextBlock Text="🔊" Foreground="White" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0"
                                Maximum="100" Value="100" VerticalAlignment="Center"
                                Focusable="False"
                                ValueChanged="VolumeSlider_ValueChanged"/>

                        <!-- Time -->
                        <TextBlock x:Name="TxtTime" Text="0:00:00 / 0:00:00"
                                   Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Subtitles -->
                        <Button x:Name="BtnSubtitles" Content="CC" ToolTip="Add subtitles"
                                Width="38" Height="38" FontSize="13" FontWeight="SemiBold"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                Focusable="False" Click="BtnSubtitles_Click"/>
                        <!-- Audio track -->
                        <Button x:Name="BtnAudioTrack" Content="🎵" ToolTip="Audio Track"
                                Width="38" Height="38" FontSize="15"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                Focusable="False" Click="BtnAudioTrack_Click"/>
                        <!-- Fullscreen -->
                        <Button Content="⛶" ToolTip="Fullscreen"
                                Width="38" Height="38" FontSize="18"
                                Foreground="White" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Focusable="False"
                                Click="BtnFullscreen_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Skip Intro button -->
        <Border x:Name="BtnSkipIntro"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,90"
                Background="#CC000000" BorderBrush="White" BorderThickness="1.5"
                CornerRadius="3" Padding="16,10" Cursor="Hand"
                Visibility="Collapsed"
                MouseLeftButtonDown="BtnSkipIntro_Click">
            <TextBlock Text="Skip Intro  ▶" Foreground="White"
                       FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <!-- Next Episode overlay button (shows near end) -->
        <Border x:Name="BtnNextEpisode"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,90"
                Background="#CC000000" BorderBrush="White" BorderThickness="1.5"
                CornerRadius="3" Padding="16,10" Cursor="Hand"
                Visibility="Collapsed"
                MouseLeftButtonDown="BtnNextEpisode_Click">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="NEXT EPISODE" Foreground="#AAAAAA"
                               FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtNextTitle" Foreground="White"
                               FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="  ▶" Foreground="White" FontSize="18"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
