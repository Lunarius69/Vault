<UserControl x:Class="Vault.Views.GameDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1a1a2e">

    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#636e72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="340">
            <Border ClipToBounds="True">
                <Grid>
                    <Image x:Name="ImgBanner" Stretch="UniformToFill"/>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#CC1a1a2e" Offset="0.6"/>
                                <GradientStop Color="#FF1a1a2e" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="BtnBack" Content="← Back"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="20,16,0,0"
                    Background="#33ffffff" Foreground="#ffffff"
                    BorderThickness="0" FontSize="13"
                    FontFamily="Segoe UI" Cursor="Hand"
                    Padding="14,6"
                    Click="BtnBack_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border x:Name="PlatformBadge" CornerRadius="4"
                            Padding="10,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtPlatform" Foreground="White"
                                   FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtStatus" Foreground="#b2bec3"
                                   FontSize="12" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtTitle"
                           Foreground="#ffffff" FontSize="32"
                           FontWeight="Bold" FontFamily="Segoe UI"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24,32,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">

                    <Button x:Name="BtnLaunch"
                            Style="{StaticResource ActionBtn}"
                            Background="#e94560" Foreground="White"
                            Margin="0,0,0,8"
                            Click="BtnLaunch_Click"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📁  Set File Path"
                                Style="{StaticResource ActionBtn}"
                                Background="#2d3561" Foreground="White"
                                Click="BtnSetPath_Click"/>
                        <Button Grid.Column="2" Content="✏  Edit Status"
                                Style="{StaticResource ActionBtn}"
                                Background="#2d3561" Foreground="White"
                                Click="BtnEditStatus_Click"/>
                    </Grid>

                    <Button x:Name="BtnMarkNotDownloaded"
                            Content="✕  Mark as Not Downloaded"
                            Style="{StaticResource ActionBtn}"
                            Background="#1a1a2e" Foreground="#636e72"
                            Margin="0,0,0,16"
                            Click="BtnMarkNotDownloaded_Click"/>

                    <TextBlock x:Name="TxtMessage" Foreground="#00b894"
                               FontSize="12" FontFamily="Segoe UI"
                               TextWrapping="Wrap" Margin="0,0,0,16"
                               Visibility="Collapsed"/>

                    <Border Background="#16213e" CornerRadius="12"
                            Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="RELEASE DATE" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="TxtYear" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="GENRE" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="TxtGenre" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="FILE SIZE" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="TxtSize" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="0" Grid.Row="1">
                                <TextBlock Text="PLAYTIME" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="TxtPlaytime" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1">
                                <TextBlock Text="LAST PLAYED" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="TxtLastPlayed" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#16213e" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource DetailLabel}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtDescription"
                                       Foreground="#b2bec3" FontSize="13"
                                       FontFamily="Segoe UI" TextWrapping="Wrap"
                                       LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <Border CornerRadius="10" ClipToBounds="True"
                            Height="220" Margin="0,0,0,16">
                        <Grid>
                            <Border x:Name="PlaceholderBg" Background="#0f3460"/>
                            <TextBlock x:Name="TxtPlaceholder"
                                       Foreground="#b2bec3" FontSize="13"
                                       FontFamily="Segoe UI" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="16"/>
                            <Image x:Name="ImgBoxArt" Stretch="UniformToFill"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Border Background="#16213e" CornerRadius="12"
                            Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="HOW LONG TO BEAT"
                                       Style="{StaticResource DetailLabel}"
                                       Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtHltbMain" Text="—"
                                               Foreground="#ffffff" FontSize="18"
                                               FontWeight="Bold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Main" Foreground="#636e72"
                                               FontSize="10" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtHltbSides" Text="—"
                                               Foreground="#ffffff" FontSize="18"
                                               FontWeight="Bold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Main+Sides" Foreground="#636e72"
                                               FontSize="10" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtHltbComplete" Text="—"
                                               Foreground="#ffffff" FontSize="18"
                                               FontWeight="Bold" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="100%" Foreground="#636e72"
                                               FontSize="10" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AchievementsPanel" Background="#16213e"
                            CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ACHIEVEMENTS"
                                       Style="{StaticResource DetailLabel}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtAchievements"
                                       Foreground="#ffffff" FontSize="22"
                                       FontWeight="Bold" FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>
                            <Grid Height="8" Margin="0,0,0,6">
                                <Border Background="#2d3561" CornerRadius="4"/>
                                <Border x:Name="AchievementBarFill"
                                        Background="#e94560" CornerRadius="4"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="TxtAchievementPct"
                                       Foreground="#636e72" FontSize="11"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>