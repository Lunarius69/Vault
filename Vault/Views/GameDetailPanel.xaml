<UserControl x:Class="Vault.Views.GameDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#16213e" Width="320">

    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#636e72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with close button -->
        <Border Grid.Row="0" BorderBrush="#2d3561" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <TextBlock Text="Game Details" Foreground="#ffffff"
                           FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnClose" Content="✕"
                        HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Background="Transparent"
                        Foreground="#636e72"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2d3561"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,24">

                <!-- Box art -->
                <Border CornerRadius="8" ClipToBounds="True"
                        Height="200" Margin="0,0,0,16">
                    <Grid>
                        <Border x:Name="PlaceholderBg" Background="#0f3460"/>
                        <TextBlock x:Name="TxtPlaceholder"
                                   Foreground="#b2bec3" FontSize="13"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="16"/>
                        <Image x:Name="ImgBoxArt" Stretch="UniformToFill"
                               Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="TxtTitle"
                           Foreground="#ffffff" FontSize="18"
                           FontWeight="Bold" FontFamily="Segoe UI"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>

                <!-- Platform badge -->
                <Border x:Name="PlatformBadge" CornerRadius="4"
                        Padding="8,3" HorizontalAlignment="Left"
                        Margin="0,0,0,12">
                    <TextBlock x:Name="TxtPlatform" Foreground="White"
                               FontSize="11" FontWeight="Bold"
                               FontFamily="Segoe UI"/>
                </Border>

                <!-- Status row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtStatus" Foreground="#b2bec3"
                               FontSize="13" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Info grid -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,12">
                        <TextBlock Text="YEAR" Style="{StaticResource DetailLabel}"/>
                        <TextBlock x:Name="TxtYear" Style="{StaticResource DetailValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="SIZE" Style="{StaticResource DetailLabel}"/>
                        <TextBlock x:Name="TxtSize" Style="{StaticResource DetailValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,12">
                        <TextBlock Text="GENRE" Style="{StaticResource DetailLabel}"/>
                        <TextBlock x:Name="TxtGenre" Style="{StaticResource DetailValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="PLAYTIME" Style="{StaticResource DetailLabel}"/>
                        <TextBlock x:Name="TxtPlaytime" Style="{StaticResource DetailValue}"/>
                    </StackPanel>
                </Grid>

                <!-- HLTB times -->
                <Border Background="#1a1a2e" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="HOW LONG TO BEAT" Foreground="#636e72"
                                   FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtHltbMain" Text="—"
                                           Foreground="#ffffff" FontSize="16"
                                           FontWeight="Bold" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Main" Foreground="#636e72"
                                           FontSize="10" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtHltbSides" Text="—"
                                           Foreground="#ffffff" FontSize="16"
                                           FontWeight="Bold" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Main+Sides" Foreground="#636e72"
                                           FontSize="10" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtHltbComplete" Text="—"
                                           Foreground="#ffffff" FontSize="16"
                                           FontWeight="Bold" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="100%" Foreground="#636e72"
                                           FontSize="10" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Description -->
                <TextBlock Text="DESCRIPTION" Style="{StaticResource DetailLabel}"/>
                <TextBlock x:Name="TxtDescription" Style="{StaticResource DetailValue}"
                           Foreground="#b2bec3" FontSize="12" Margin="0,0,0,16"/>

                <!-- Action buttons -->
                <Button x:Name="BtnLaunch" Content="▶  Launch Game"
                        Style="{StaticResource ActionBtn}"
                        Background="#e94560" Foreground="White"
                        Click="BtnLaunch_Click"/>

                <Button x:Name="BtnSetPath" Content="📁  Set File Path"
                        Style="{StaticResource ActionBtn}"
                        Background="#2d3561" Foreground="White"
                        Click="BtnSetPath_Click"/>

                <Button x:Name="BtnEditStatus" Content="✏  Edit Status"
                        Style="{StaticResource ActionBtn}"
                        Background="#2d3561" Foreground="White"
                        Click="BtnEditStatus_Click"/>

                <!-- Status message -->
                <TextBlock x:Name="TxtMessage" Foreground="#00b894"
                           FontSize="11" FontFamily="Segoe UI"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
