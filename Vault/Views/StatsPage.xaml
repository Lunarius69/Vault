<UserControl x:Class="Vault.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1a1a2e">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Games Statistics -->
            <Border Grid.Row="0" Background="#16213e" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Games Statistics" FontSize="18" FontWeight="Bold" 
                               Foreground="#e94560" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Total Games" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtTotalGames" Foreground="#ffffff" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Playing" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtPlayingGames" Foreground="#00b894" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Completed" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtCompletedGames" Foreground="#0984e3" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Not Started" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtNotStartedGames" Foreground="#636e72" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Downloaded" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtDownloadedGames" Foreground="#e94560" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Total Playtime" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtTotalPlaytime" Foreground="#ffffff" FontSize="18" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Platform Distribution -->
            <Border Grid.Row="1" Background="#16213e" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Platform Distribution" FontSize="18" FontWeight="Bold" 
                               Foreground="#e94560" Margin="0,0,0,16"/>
                    <ListBox x:Name="PlatformListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Platform}" 
                                               Foreground="#b2bec3"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" 
                                               Foreground="#e94560" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Media Statistics -->
            <Border Grid.Row="2" Background="#16213e" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Media Statistics" FontSize="18" FontWeight="Bold" 
                               Foreground="#e94560" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Total Movies" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtTotalMovies" Foreground="#ffffff" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Total Shows" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtTotalShows" Foreground="#ffffff" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Currently Watching" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtWatchingMedia" Foreground="#fdcb6e" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Completed" Foreground="#636e72" FontSize="12"/>
                            <TextBlock x:Name="TxtCompletedMedia" Foreground="#0984e3" FontSize="24" 
                                       FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>