<UserControl x:Class="Vault.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1a1a2e">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#636e72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="StatSubValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#b2bec3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <TextBlock Text="Library Statistics"
                       Foreground="#ffffff" FontSize="24"
                       FontWeight="Bold" FontFamily="Segoe UI"
                       Margin="0,0,0,24"/>

            <!-- Top stat cards row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Games -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL GAMES" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtTotalGames" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="TxtTotalGamesSub" Style="{StaticResource StatSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Total Playtime -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL PLAYTIME" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtTotalPlaytime" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="TxtTotalPlaytimeSub" Style="{StaticResource StatSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Total Media -->
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="MEDIA WATCHED" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtTotalMedia" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="TxtTotalMediaSub" Style="{StaticResource StatSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Library Size -->
                <Border Grid.Column="6" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="LIBRARY SIZE" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtLibrarySize" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="TxtLibrarySizeSub" Style="{StaticResource StatSubValue}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Second row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Watch time estimate -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="EST. WATCH TIME" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtWatchTime" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="TxtWatchTimeSub" Style="{StaticResource StatSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Shows watched -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="SHOWS / ANIME" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtShowsWatched" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="TxtShowsWatchedSub" Style="{StaticResource StatSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Movies watched -->
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="MOVIES WATCHED" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="TxtMoviesWatched" Style="{StaticResource StatValue}"/>
                        <TextBlock x:Name="TxtMoviesWatchedSub" Style="{StaticResource StatSubValue}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Middle row: Games by status + Games by platform -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Games by status -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="GAMES BY STATUS"
                                   Style="{StaticResource StatLabel}"
                                   Margin="0,0,0,16"/>
                        <StackPanel x:Name="GameStatusPanel"/>
                    </StackPanel>
                </Border>

                <!-- Games by platform -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="GAMES BY PLATFORM"
                                   Style="{StaticResource StatLabel}"
                                   Margin="0,0,0,16"/>
                        <StackPanel x:Name="PlatformPanel"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom row: Most played + Recently played -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Most played games -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="MOST PLAYED GAMES"
                                   Style="{StaticResource StatLabel}"
                                   Margin="0,0,0,16"/>
                        <StackPanel x:Name="MostPlayedPanel"/>
                    </StackPanel>
                </Border>

                <!-- Recently played/watched -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="RECENTLY PLAYED / WATCHED"
                                   Style="{StaticResource StatLabel}"
                                   Margin="0,0,0,16"/>
                        <StackPanel x:Name="RecentPanel"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>